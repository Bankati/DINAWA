# Dépendances (réinstallées dans Docker)
node_modules/
apps/backend/node_modules/

# Build précédents
dist/
apps/backend/dist/

# Environnement
.env
.env.*
!.env.example

# Tests
coverage/
apps/backend/coverage/
**/*.spec.ts
**/*.e2e-spec.ts
test/

# Docs et configs locaux
README.md
CONTRIBUTING.md
docs/
.vscode/
.idea/

# Git
.git/
.gitignore
.github/

# Frontend (inutile pour le backend) — le Dockerfile ne copie que
# apps/backend/, mais le contexte complet est quand même transféré au
# démon Docker sans cette exclusion. Exception : son package.json seul
# reste nécessaire pour que `npm ci` (workspaces racine) valide que
# package-lock.json est en phase avec TOUS les workspaces déclarés.
apps/frontend/
!apps/frontend/package.json
image logo/
*.docx

# Logs
*.log
logs/

# Temp
*.tmp
