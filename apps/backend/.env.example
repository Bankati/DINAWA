# ═══════════════════════════════════════════════════════════════
# WARAH — Backend — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs réelles.
# NE JAMAIS commiter le fichier .env
# Voir docs/ENV.md pour les instructions complètes.
# ═══════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────
NODE_ENV=development
# Port d'écoute (Railway injecte automatiquement $PORT en prod)
PORT=3000

# ── Base de données — Supabase PostgreSQL ─────────────────────
# Transaction pooler (port 6543) — utilisé par l'application en production (pgBouncer)
# Format : postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.VOTRE_PROJECT_REF:VOTRE_MOT_DE_PASSE@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Connexion directe (port 5432) — utilisée par prisma migrate deploy (ne pas utiliser pgBouncer ici)
DIRECT_URL=postgresql://postgres.VOTRE_PROJECT_REF:VOTRE_MOT_DE_PASSE@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# ── Supabase ──────────────────────────────────────────────────
# Disponible dans : Settings → API
SUPABASE_URL=https://VOTRE_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.VOTRE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.VOTRE_SERVICE_ROLE_KEY
# ── Authentification interne ─────────────────────────────────
# Signature des access tokens JWT — authentification gérée entièrement
# côté NestJS (bcrypt + JWT + refresh tokens en base), plus de dépendance
# à Supabase Auth. Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=VOTRE_SECRET_JWT

# ── Resend — Emails transactionnels ───────────────────────────
# Créer une clé API sur resend.com → API Keys
RESEND_API_KEY=re_VOTRE_CLE_API
# Adresse expéditrice vérifiée dans Resend (domaine vérifié requis)
RESEND_FROM_EMAIL=noreply@warah.tg
RESEND_FROM_NAME=WARAH

# ── Contact ───────────────────────────────────────────────────
# Adresse recevant les messages du formulaire de contact public (/contact)
CONTACT_RECIPIENT_EMAIL=contact@warah.tg

# ── Web Push — Notifications push VAPID ──────────────────────
# Générer les clés : npx web-push generate-vapid-keys
# (voir docs/ENV.md pour la procédure complète)
VAPID_PUBLIC_KEY=BI0VOTRE_CLE_PUBLIQUE_VAPID
VAPID_PRIVATE_KEY=VOTRE_CLE_PRIVEE_VAPID
# Contact pour les serveurs push (mailto ou URL)
VAPID_SUBJECT=mailto:contact@warah.tg

# ── PayDunya — Mobile money (T-Money & Moov/Flooz Togo) ──────
# COMPTE MARCHAND REQUIS — voir docs/DEPLOYMENT.md pour la procédure
# test = bac à sable PayDunya (aucun vrai argent), live = production réelle
PAYDUNYA_MODE=test
# Master key — identique en test et en production
PAYDUNYA_MASTER_KEY=VOTRE_MASTER_KEY_PAYDUNYA
PAYDUNYA_TEST_PUBLIC_KEY=VOTRE_CLE_PUBLIQUE_TEST
PAYDUNYA_TEST_PRIVATE_KEY=VOTRE_CLE_PRIVEE_TEST
PAYDUNYA_TEST_TOKEN=VOTRE_TOKEN_TEST
PAYDUNYA_LIVE_PUBLIC_KEY=VOTRE_CLE_PUBLIQUE_LIVE
PAYDUNYA_LIVE_PRIVATE_KEY=VOTRE_CLE_PRIVEE_LIVE
PAYDUNYA_LIVE_TOKEN=VOTRE_TOKEN_LIVE

# URL publique de ce backend (suffixe /api inclus) — PayDunya l'utilise pour
# nous rappeler après un paiement (callback_url)
API_BASE_URL=http://localhost:3001/api

# ── Sentry — Monitoring d'erreurs (optionnel en dev) ─────────
# COMPTE SENTRY REQUIS — voir docs/DEPLOYMENT.md
# Laisser vide en dev local pour désactiver Sentry
SENTRY_DSN=

# ── CORS ──────────────────────────────────────────────────────
# Liste des origines autorisées, séparées par des virgules — le frontend
# Next.js tourne sur le port 3000 en dev (jamais 4300, ancien port Angular)
# En prod : URL Vercel + éventuellement domaine custom
ALLOWED_ORIGINS=http://localhost:3000,https://warah.vercel.app

# ── Frontend ──────────────────────────────────────────────────
# URL utilisée dans les emails transactionnels (confirmation d'inscription,
# lien d'activation locataire) — jamais un redirectTo Supabase
FRONTEND_URL=http://localhost:3000

# ── Invitation locataire ──────────────────────────────────────
# Secret HMAC pour signer les liens d'invitation (expiration 7 jours)
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INVITATION_TOKEN_SECRET=VOTRE_SECRET_HMAC_INVITATION
