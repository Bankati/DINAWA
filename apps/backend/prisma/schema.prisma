// ════════════════════════════════════════════════════════════════
// Schéma Prisma — WARAH
//
// Toutes les dates sont stockées en UTC (@db.Timestamptz). Togo =
// UTC+0 sans DST : UTC ≡ Africa/Lomé, donc pas de conversion à
// l'écriture, uniquement à l'affichage (PDF, email).
//
// Les montants FCFA sont stockés en Int (pas de sous-unité pour
// cette devise) — jamais de Float ni de Decimal pour l'argent.
//
// Toutes les relations transverses (Property, Lease, Mandate,
// Payment...) pointent directement vers User.id, jamais vers un
// profil de rôle (OwnerProfile/TenantProfile/ManagerProfile). Les
// profils de rôle ne portent que des champs spécifiques au rôle et
// ne sont jamais la cible d'une clé étrangère venant d'un autre
// module métier.
// ════════════════════════════════════════════════════════════════

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["omitApi"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ────────────────────────────────────────────────────────────────
// Énumérations
// ────────────────────────────────────────────────────────────────

enum UserRole {
  OWNER
  TENANT
  MANAGER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED_INACTIVITY
  SUSPENDED_ADMIN
  SUSPENDED_PAYMENT
}

enum NotificationConsent {
  NOT_ASKED
  ACCEPTED
  DECLINED
}

// Liste alignée sur le marché locatif togolais (voir demande développeur,
// 2026-10-03) — VILLA/APARTMENT/STUDIO/COMMERCIAL existaient déjà et ne sont
// jamais renommés (éviter une migration d'enum destructive côté Postgres) ;
// COMMERCIAL correspond au libellé "Professionnel" côté frontend.
enum PropertyType {
  CHAMBRE_SIMPLE
  CHAMBRE_SALON
  DEUX_CHAMBRES_SALON
  TROIS_CHAMBRES_SALON
  STUDIO
  APARTMENT
  VILLA
  VILLA_DUPLEX
  VILLA_MEUBLEE
  APPARTEMENT_MEUBLE
  COMMERCIAL
  MAGASIN
  BOUTIQUE
}

enum PropertyStatus {
  OCCUPIED
  VACANT
  RENOVATION
  ARCHIVED
}

enum PropertyDocumentType {
  STATE_OF_PLAY
  PROPERTY_TITLE
  INSURANCE
  OTHER
}

enum LeaseStatus {
  ACTIVE
  TERMINATED
  EXPIRED
}

enum PaymentFrequency {
  MONTHLY
  QUARTERLY
  BIANNUAL
  ANNUAL
}

enum ScheduleEntryStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
}

enum PaymentStatus {
  PENDING
  PENDING_CONFIRMATION
  PAID
  PARTIAL
  LATE
  OVERDUE
  REJECTED
}

enum PaymentSource {
  PAYDUNYA_API
  MANUAL_OWNER
  TENANT_DECLARATION
}

enum PaymentMethod {
  TMONEY
  FLOOZ
  CASH
  BANK_TRANSFER
}

// Opérateurs mobile money acceptés pour RECEVOIR un reversement (Togo) —
// enum dédié plutôt que PaymentMethod, qui contient aussi CASH/BANK_TRANSFER.
enum PayoutOperator {
  TMONEY
  FLOOZ
}

// PENDING : à envoyer (ou à renvoyer après un échec temporaire, voir
// nextAttemptAt). SENDING : pris en charge, jeton PayDunya créé, résultat
// pas encore connu. SUCCESS/FAILED : états finaux (FAILED relançable par un
// admin uniquement).
enum PayoutStatus {
  PENDING
  SENDING
  SUCCESS
  FAILED
}

enum ListingStatus {
  ACTIVE
  DISABLED
  SUSPENDED
}

enum MandateStatus {
  PENDING
  ACTIVE
  REVOKED
  EXPIRED
}

enum MandateFeeType {
  PERCENTAGE
  FLAT
}

enum SubscriptionTier {
  STARTER
  PRO
  PREMIUM
  AGENCE
}

enum SubscriptionStatus {
  ACTIVE
  PENDING_CANCELLATION
  CANCELLED
}

enum InvoiceStatus {
  PENDING
  PAID
  FAILED
}

enum NotificationChannel {
  PUSH
  EMAIL
  WHATSAPP
}

// Consentement aux messages WhatsApp (unité 42, /architect 2026-10-08,
// révisé à l'unité 45). Toutes les transitions passent par
// whatsapp-consent/consent-transition.ts — jamais d'écriture directe.
// PENDING = l'agence a déclaré l'accord, le locataire ne l'a pas encore
// confirmé (« OUI ») : rien ne part. Seul le locataire fait passer à
// ACCEPTED (OUI, espace locataire, REPRENDRE). STOPPED = arrêt (STOP,
// retrait, refus noté par l'agence) : seul le locataire peut en sortir.
enum WhatsappConsent {
  NOT_ASKED
  PENDING
  ACCEPTED
  STOPPED
}

// Moyen par lequel le consentement a changé. SYSTEM = changement fait par
// WARAH sans personne derrière (ex. suppression de compte) — seul cas où
// WhatsappConsentEvent.actorUserId est null.
enum WhatsappConsentSource {
  AGENCY
  BOT
  TENANT_PORTAL
  SYSTEM
}

// Nature d'une ligne d'historique (unité 45) : changement d'état du
// consentement, ou changement du numéro WhatsApp (qui remet tout à zéro).
enum WhatsappConsentEventKind {
  CONSENT
  PHONE_CHANGE
}

// Façon dont l'agence a recueilli l'accord ou le refus du locataire
// (unité 45, décision 1) — jamais de texte libre.
enum WhatsappConsentMethod {
  IN_PERSON
  PHONE
  WRITTEN
}

// Robot WhatsApp (unité 47) : où en est la conversation. AWAITING_PIN = le
// robot vient de demander le code pour une action protégée (pendingAction).
// HUMAN (unité 48) : échange avec le responsable du bien en cours, le robot
// se tait et relaie les messages (WhatsappConversation.humanThreadId).
enum WhatsappBotState {
  MENU
  AWAITING_PIN
  HUMAN
}

// Pourquoi un échange humain s'est terminé (unité 48). TIMEOUT : 24 h sans
// message du locataire (constaté au message suivant, l'état affiché est
// toujours calculé). SYSTEM : changement de numéro.
enum WhatsappThreadCloseReason {
  AGENCY
  TENANT
  TIMEOUT
  STOP
  SYSTEM
}

// Actions protégées par le code locataire (unité 47, décision 2). « Payer »
// n'en fait pas partie : le lien ne montre que prénom, logement et montant.
enum WhatsappBotAction {
  RECEIPT
  STATEMENT
}

enum WhatsappDirection {
  OUTBOUND
  INBOUND
}

// INTERACTIVE à OTHER : messages reçus (unité 44). OTHER = localisation,
// contact, réaction, autocollant... — seul le type Meta est gardé
// (payload.metaType), jamais le contenu.
enum WhatsappMessageType {
  TEMPLATE
  TEXT
  DOCUMENT
  INTERACTIVE
  IMAGE
  AUDIO
  VIDEO
  OTHER
}

// Classé selon ce que l'on SAIT du message, jamais selon ce qu'on espère
// (voir architecture.md, section WhatsApp) :
// - QUEUED  : intention enregistrée, appel Meta pas encore terminé
// - SENT    : Meta a répondu 2xx avec un wamid
// - FAILED  : Meta a refusé de façon déterministe (rien n'est parti)
// - UNKNOWN : timeout, coupure, 5xx ou réponse sans wamid — on ne sait pas
//   si Meta a pris le message. Jamais renvoyé automatiquement (doublon).
// - RECEIVED : message ENTRANT (direction INBOUND, unité 44) — jamais un
//   envoi de WARAH, donc jamais concerné par les renvois.
enum WhatsappMessageStatus {
  QUEUED
  SENT
  FAILED
  UNKNOWN
  RECEIVED
}

enum NotificationDispatchStatus {
  SENT
  FAILED
}

enum ContactMessageStatus {
  NEW
  HANDLED
}

// ────────────────────────────────────────────────────────────────
// Comptes utilisateurs
// ────────────────────────────────────────────────────────────────

model User {
  id                              String              @id @default(cuid())
  // Vestige de l'ancienne authentification via Supabase Auth (retirée le
  // 2026-08-11) — plus jamais renseigné pour un nouveau compte, conservé
  // nullable pour d'éventuels comptes legacy non encore recréés.
  supabaseId                      String?             @unique
  email                           String?             @unique
  phone                           String?             @unique
  // Opérateur mobile money du numéro ci-dessus — demandé une fois à
  // l'inscription (OWNER/MANAGER uniquement, voir signup-owner.dto.ts /
  // signup-manager.dto.ts) puisque PayDunya a besoin de savoir si un numéro
  // est T-Money ou Flooz pour y reverser un loyer (voir PayoutsService,
  // /architect reversement 2026-09-25, révisé le 2026-09-28 : le numéro de
  // réception est désormais le même que `phone`, plus de numéro séparé).
  // Toujours null pour TENANT/ADMIN. Modifier `phone` ou `payoutOperator`
  // pour un OWNER/MANAGER exige le mot de passe (voir ProfileService).
  payoutOperator                  PayoutOperator?
  // bcrypt (12 rounds) — voir modules/auth/token.service.ts. Authentification
  // gérée entièrement côté NestJS depuis le 2026-08-11 (voir architecture.md).
  passwordHash                    String
  role                            UserRole
  firstName                       String
  lastName                        String
  // Ville de résidence — texte libre, aucune logique métier attachée
  // (contrairement à OwnerProfile.residenceCountry qui pilote la distinction
  // local/diaspora). Voir /architect révision inscription owner/manager.
  city                            String?
  accountStatus                   AccountStatus       @default(ACTIVE)
  // Motif de la suspension manuelle par un admin (accountStatus =
  // SUSPENDED_ADMIN uniquement) — remis à null à la réactivation. Les
  // suspensions automatiques (inactivité/paiement abonnement) ne renseignent
  // jamais ce champ, leur motif est implicite dans accountStatus lui-même.
  suspensionReason                String?
  notificationConsent             NotificationConsent @default(NOT_ASKED)
  reminderDaysBefore              Int                 @default(5)
  overdueGraceDays                Int                 @default(3)
  profilePhotoPath                String?
  // Blocage temporaire après 5 échecs de connexion consécutifs (voir
  // build-plan.md unité 10) — remis à zéro sur connexion réussie.
  failedLoginAttempts             Int                 @default(0)
  lockedUntil                     DateTime?           @db.Timestamptz(6)
  // Anti-doublon pour les rappels d'inactivité (voir build-plan.md unité 11)
  // — remis à `null` dès que le compte redevient actif, pour que le prochain
  // cycle d'inactivité reparte de zéro.
  inactivityWarning30SentAt       DateTime?           @db.Timestamptz(6)
  inactivityWarning7SentAt        DateTime?           @db.Timestamptz(6)
  inactivityWarning1SentAt        DateTime?           @db.Timestamptz(6)
  anonymizedAt                    DateTime?           @db.Timestamptz(6)
  // Canal WhatsApp (unité 42). whatsappPhone : 8 chiffres, null = utiliser
  // `phone` — attention, `phone` est stocké tel que saisi (90330557,
  // 22890330557 ou +22890330557) : toute recherche par numéro passe par
  // storedPhoneVariants() (/review unité 44). Unique : le robot doit retrouver sans ambiguïté le
  // locataire à partir du numéro qui lui écrit. Le format Meta (228XXXXXXXX)
  // n'est jamais stocké — voir common/utils/phone.ts.
  whatsappPhone                   String?             @unique
  whatsappConsent                 WhatsappConsent     @default(NOT_ASKED)
  whatsappConsentAt               DateTime?           @db.Timestamptz(6)
  whatsappConsentById             String?
  whatsappStoppedAt               DateTime?           @db.Timestamptz(6)
  // Unité 45. Heure du dernier changement d'état OU de numéro : un « OUI »
  // ou un « REPRENDRE » dont l'heure Meta n'est pas strictement postérieure
  // est ignoré (messages livrés dans le désordre). Un STOP s'applique
  // toujours.
  whatsappConsentChangedAt        DateTime?           @db.Timestamptz(6)
  // Demande d'accord en cours (état PENDING) : id de l'événement qui l'a
  // créée et date limite pour que le locataire réponde « OUI ».
  whatsappConsentRequestId        String?
  whatsappConsentRequestExpiresAt DateTime?           @db.Timestamptz(6)
  // Numéro vérifié = WARAH a reçu un message de ce numéro (authentifié par
  // Meta). On garde le numéro lui-même (8 chiffres) et pas seulement la
  // date : si le numéro utilisé change, par n'importe quel écran, il n'est
  // automatiquement plus vérifié. Aucun envoi sans numéro vérifié.
  whatsappVerifiedPhone           String?
  whatsappPhoneVerifiedAt         DateTime?           @db.Timestamptz(6)
  // Robot (unité 47, décision 1) : heure de la dernière invitation envoyée
  // à un locataire sans accord (« répondez OUI »). Une par 24 h au plus,
  // réservée par écriture conditionnelle ; un « OUI » ne vaut accord que
  // dans les 24 h qui suivent.
  whatsappInvitedAt               DateTime?           @db.Timestamptz(6)
  createdAt                       DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt                       DateTime            @updatedAt @db.Timestamptz(6)

  ownerProfile   OwnerProfile?
  tenantProfile  TenantProfile?
  managerProfile ManagerProfile?
  adminProfile   AdminProfile?

  tenantsInvited         TenantProfile[]        @relation("TenantInvitedBy")
  ownedProperties        Property[]             @relation("PropertyOwner")
  listingsPublished      Listing[]
  leasesAsOwner          Lease[]                @relation("LeaseOwner")
  leasesAsTenant         Lease[]                @relation("LeaseTenant")
  tenantBlocksReceived   TenantPropertyBlock[]  @relation("TenantPropertyBlockTenant")
  tenantBlocksAuthored   TenantPropertyBlock[]  @relation("TenantPropertyBlockAuthor")
  mandatesAsOwner        Mandate[]              @relation("MandateOwner")
  mandatesAsManager      Mandate[]              @relation("MandateManager")
  paymentsRecorded       Payment[]              @relation("PaymentRecordedBy")
  paymentsConfirmed      Payment[]              @relation("PaymentConfirmedBy")
  paymentsAsBeneficiary  Payment[]              @relation("PaymentBeneficiary")
  payouts                Payout[]               @relation("PayoutBeneficiary")
  managerReviewsGiven    ManagerReview[]        @relation("ManagerReviewOwner")
  managerReviewsReceived ManagerReview[]        @relation("ManagerReviewManager")
  subscription           Subscription?
  pushSubscriptions      PushSubscription[]
  passwordResetOtps      PasswordResetOtp[]
  sessions               Session[]
  notifications          Notification[]
  auditLogs              AuditLog[]
  whatsappMessages       WhatsappMessage[]
  whatsappConsentEvents  WhatsappConsentEvent[] @relation("WhatsappConsentSubject")
  whatsappConsentActions WhatsappConsentEvent[] @relation("WhatsappConsentActor")
  whatsappConversation   WhatsappConversation?
  whatsappThreads        WhatsappThread[]       @relation("WhatsappThreadTenant")

  @@map("users")
}

// Refresh tokens de connexion — un enregistrement par session active,
// remplacé (rotation) à chaque utilisation de /auth/refresh (voir
// TokenService.rotateSession()). refreshTokenHash est un SHA-256 simple, pas
// bcrypt : le refresh token est déjà un secret aléatoire à haute entropie
// (32 octets), pas un mot de passe choisi par un humain — un hash rapide et
// une simple comparaison suffisent, bcrypt n'apporterait rien ici.
model Session {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  expiresAt        DateTime  @db.Timestamptz(6)
  revokedAt        DateTime? @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)

  @@index([userId])
  @@map("sessions")
}

model OwnerProfile {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  residenceCountry String
  betaUntil        DateTime? @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(6)

  @@map("owner_profiles")
}

// Créé dès `POST /api/tenants` par le propriétaire/gestionnaire — userId
// existe donc avant même que le locataire n'ait terminé son inscription
// via le lien d'invitation (voir unité 09).
model TenantProfile {
  id                String    @id @default(cuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitedByUserId   String?
  invitedBy         User?     @relation("TenantInvitedBy", fields: [invitedByUserId], references: [id])
  // Code locataire à 6 chiffres réservé au robot WhatsApp (unité 42) — haché
  // bcrypt via TokenService, jamais en clair ni dans les logs. 1 000 000 de
  // possibilités seulement : bcrypt ne protège pas de la force brute, d'où le
  // compteur + blocage (5 essais puis 1 h, appliqués par le robot, unité 47),
  // comptés par locataire et jamais par IP (tout arrive des serveurs Meta).
  whatsappPinHash   String?
  pinFailedAttempts Int       @default(0)
  pinLockedUntil    DateTime? @db.Timestamptz(6)
  // Dernier bon code donné au robot (unité 47) : ouvre les actions
  // protégées pendant 30 jours, seulement si le numéro vérifié est toujours
  // pinVerifiedPhone. Effacé à chaque nouveau code, réinitialisation ou
  // changement de numéro.
  pinVerifiedAt     DateTime? @db.Timestamptz(6)
  pinVerifiedPhone  String?
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(6)

  @@map("tenant_profiles")
}

model ManagerProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Facultatif — un gestionnaire peut être un particulier sans structure
  // enregistrée (voir demande développeur, 2026-10-03). Texte libre, aucune
  // logique métier attachée (même traitement que `city`/`pricingNote`).
  companyName         String?
  zonesOfIntervention String[] @default([])
  pricingNote         String?
  ratingAverage       Float    @default(0)
  ratingCount         Int      @default(0)
  createdAt           DateTime @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @db.Timestamptz(6)

  @@map("manager_profiles")
}

model AdminProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@map("admin_profiles")
}

model PasswordResetOtp {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  expiresAt DateTime  @db.Timestamptz(6)
  usedAt    DateTime? @db.Timestamptz(6)
  // Essais de confirmation déjà faits sur ce code (audit sécurité du
  // 2026-10-20, E1) : au-delà de PASSWORD_RESET_MAX_ATTEMPTS, le code est
  // annulé — un code à 6 chiffres ne doit pas pouvoir être deviné.
  attempts  Int       @default(0)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  @@index([userId])
  @@map("password_reset_otps")
}

// ────────────────────────────────────────────────────────────────
// Patrimoine immobilier
// ────────────────────────────────────────────────────────────────

model Property {
  id             String         @id @default(cuid())
  ownerId        String
  owner          User           @relation("PropertyOwner", fields: [ownerId], references: [id])
  type           PropertyType
  status         PropertyStatus @default(VACANT)
  // Optionnel depuis 2026-09-22 (demande développeur) — Quartier + Ville
  // suffisent à identifier un bien, l'adresse précise n'est plus jugée
  // utile. Champ conservé (pas supprimé) pour les biens déjà saisis.
  address        String?
  neighborhood   String
  city           String
  // Regroupement libre de plusieurs biens au même endroit physique (ex. un
  // immeuble de 6 appartements) — texte libre volontairement, pas de table
  // dédiée : aucune fonctionnalité de cette passe n'exige de fiche immeuble
  // à part entière, juste grouper/filtrer (voir /architect 2026-09-20).
  building       String?
  surfaceArea    Float?
  roomsCount     Int?
  monthlyRent    Int
  monthlyCharges Int            @default(0)
  description    String?
  archivedAt     DateTime?      @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(6)

  photos          PropertyPhoto[]
  documents       PropertyDocument[]
  leases          Lease[]
  mandates        Mandate[]
  listings        Listing[]
  tenantBlocks    TenantPropertyBlock[]
  whatsappThreads WhatsappThread[]

  @@index([ownerId])
  @@index([status])
  @@index([type])
  @@index([building])
  @@index([city, neighborhood])
  @@map("properties")
}

model PropertyPhoto {
  id          String   @id @default(cuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  storagePath String
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  @@index([propertyId])
  @@map("property_photos")
}

model PropertyDocument {
  id          String               @id @default(cuid())
  propertyId  String
  property    Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  type        PropertyDocumentType
  storagePath String
  createdAt   DateTime             @default(now()) @db.Timestamptz(6)

  @@index([propertyId])
  @@map("property_documents")
}

// Blocage d'un locataire pour un bien précis (voir build-plan.md unité 14)
// — jamais global au compte, jamais à l'échelle du propriétaire. Le même
// locataire reste invitable par le même propriétaire pour un autre bien, ou
// par n'importe quel autre propriétaire. Vérifié dès l'invitation
// (AuthService.inviteTenant()), pas seulement à la création du bail.
model TenantPropertyBlock {
  id              String   @id @default(cuid())
  propertyId      String
  property        Property @relation(fields: [propertyId], references: [id])
  tenantUserId    String
  tenant          User     @relation("TenantPropertyBlockTenant", fields: [tenantUserId], references: [id])
  blockedByUserId String
  blockedBy       User     @relation("TenantPropertyBlockAuthor", fields: [blockedByUserId], references: [id])
  reason          String
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  @@unique([propertyId, tenantUserId])
  @@index([tenantUserId])
  @@map("tenant_property_blocks")
}

// Contrainte non exprimable en Prisma : un seul Lease ACTIVE par
// tenantUserId à la fois — déjà en base (migration
// 20260701104113_partial_unique_active_constraints, unité 02),
// `leases_tenant_active_unique`.
model Lease {
  id                      String           @id @default(cuid())
  propertyId              String
  property                Property         @relation(fields: [propertyId], references: [id])
  ownerId                 String
  owner                   User             @relation("LeaseOwner", fields: [ownerId], references: [id])
  tenantUserId            String
  tenant                  User             @relation("LeaseTenant", fields: [tenantUserId], references: [id])
  monthlyRent             Int
  monthlyCharges          Int              @default(0)
  paymentFrequency        PaymentFrequency
  startDate               DateTime         @db.Timestamptz(6)
  endDate                 DateTime?        @db.Timestamptz(6)
  securityDeposit         Int              @default(0)
  depositReturnConditions String?
  status                  LeaseStatus      @default(ACTIVE)
  terminatedAt            DateTime?        @db.Timestamptz(6)
  terminationReason       String?
  // Réglages propres à ce bail (voir build-plan.md unité 15, /architect) —
  // jamais liés à `User.reminderDaysBefore`/`overdueGraceDays` (réglages
  // globaux distincts, non utilisés par cette unité). Optionnels : `null`
  // signifie aucun rappel/alerte configuré pour ce bail. Stockage
  // uniquement — l'envoi effectif reste pour les unités 24/25.
  reminderDaysBefore      Int?
  overdueAlertWindowDays  Int?
  createdAt               DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime         @updatedAt @db.Timestamptz(6)

  scheduleEntries PaymentScheduleEntry[]
  payments        Payment[]

  @@index([propertyId])
  @@index([ownerId])
  @@index([tenantUserId])
  @@index([status])
  @@map("leases")
}

// ────────────────────────────────────────────────────────────────
// Paiements
// ────────────────────────────────────────────────────────────────

model PaymentScheduleEntry {
  id                  String              @id @default(cuid())
  leaseId             String
  lease               Lease               @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  periodStart         DateTime            @db.Timestamptz(6)
  periodEnd           DateTime            @db.Timestamptz(6)
  dueDate             DateTime            @db.Timestamptz(6)
  expectedAmount      Int
  paidAmount          Int                 @default(0)
  status              ScheduleEntryStatus @default(PENDING)
  reminderSentAt      DateTime?           @db.Timestamptz(6)
  overdueAlertSentAt  DateTime?           @db.Timestamptz(6)
  // Relance du LOCATAIRE en retard (unité 46) — une seule fois, au même
  // délai de tolérance que l'alerte agence. Réservée par une écriture
  // conditionnelle juste avant l'envoi (qui vérifie aussi que l'échéance est
  // toujours impayée) ; effacée si l'envoi lève une erreur avant tout envoi.
  // Sens : « relance prise en charge », chaque canal a son propre suivi.
  tenantOverdueSentAt DateTime?           @db.Timestamptz(6)
  createdAt           DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime            @updatedAt @db.Timestamptz(6)

  payments         Payment[]
  whatsappMessages WhatsappMessage[]

  @@index([leaseId])
  @@index([dueDate])
  @@index([status])
  @@map("payment_schedule_entries")
}

// Un Payment source = PAYDUNYA_API ne peut jamais être re-confirmé ni
// rejeté manuellement (voir invariants architecture.md #4) — l'idempotence
// du webhook repose sur transactionId unique, jamais sur une vérification
// applicative seule. Agrégateur PayDunya depuis le 2026-09-07 (le client a
// changé d'agrégateur — Cashpay n'a jamais été branché en réalité, voir
// /architect du même jour).
//
// Un seul Payment PAYDUNYA_API PENDING à la fois par échéance — garantie
// par l'index unique partiel `payments_schedule_entry_paydunya_pending_unique`
// (migration 20260910..., non exprimable dans ce schéma : Prisma ne gère pas
// les index partiels WHERE ...). Empêche deux `initiate()` concurrents de
// créer deux factures PayDunya pour la même échéance (trouvé en /review
// 2026-09-10).
model Payment {
  id                  String               @id @default(cuid())
  scheduleEntryId     String
  scheduleEntry       PaymentScheduleEntry @relation(fields: [scheduleEntryId], references: [id])
  leaseId             String
  lease               Lease                @relation(fields: [leaseId], references: [id])
  source              PaymentSource
  status              PaymentStatus        @default(PENDING)
  paymentMethod       PaymentMethod?
  paidAmount          Int
  paidAt              DateTime?            @db.Timestamptz(6)
  transactionId       String?              @unique
  // URL de paiement telle que renvoyée par PayDunya (jamais reconstruite —
  // l'hôte diffère entre sandbox et prod). Rejouée à l'identique si le
  // locataire relance un paiement encore PENDING (voir initiate()).
  paydunyaCheckoutUrl String?
  proofStoragePath    String?
  note                String?
  recordedByUserId    String?
  recordedBy          User?                @relation("PaymentRecordedBy", fields: [recordedByUserId], references: [id])
  confirmedByUserId   String?
  confirmedBy         User?                @relation("PaymentConfirmedBy", fields: [confirmedByUserId], references: [id])
  confirmedAt         DateTime?            @db.Timestamptz(6)
  rejectionReason     String?
  // Frais de service payés EN PLUS du loyer par le locataire (PayDunya
  // collecte loyer + frais, seul `paidAmount` est crédité à l'échéance et
  // reversé au bénéficiaire — voir /architect reversement, 2026-09-25). 0 pour
  // tout paiement antérieur à cette fonctionnalité ou non-PayDunya.
  feeAmount           Int                  @default(0)
  // Qui recevra le loyer (gestionnaire du mandat actif, sinon propriétaire),
  // figé à la création de la facture PayDunya. null = paiement antérieur au
  // reversement automatique ou non-PayDunya : jamais reversé rétroactivement.
  beneficiaryUserId   String?
  beneficiary         User?                @relation("PaymentBeneficiary", fields: [beneficiaryUserId], references: [id])
  createdAt           DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(6)

  declaration      PaymentDeclaration?
  payout           Payout?
  whatsappMessages WhatsappMessage[]

  @@index([leaseId])
  @@index([scheduleEntryId])
  @@index([status])
  @@index([paidAt])
  @@map("payments")
}

// Reversement du loyer d'un paiement PayDunya vers son bénéficiaire (API PUSH
// PayDunya, voir /architect reversement 2026-09-25). Un seul par Payment
// (paymentId unique) : c'est ce qui rend la création idempotente si
// l'événement payment.confirmed est rejoué ou rattrapé par le cron.
// `operator`/`phone` sont posés au moment de l'envoi (dernier numéro connu du
// bénéficiaire) et gardés ici comme trace de la destination réelle.
// `disburseToken` (jeton PayDunya) est la clé de la machine à états : on ne
// renvoie jamais d'argent sans avoir d'abord vérifié son statut chez PayDunya.
model Payout {
  id                String          @id @default(cuid())
  paymentId         String          @unique
  payment           Payment         @relation(fields: [paymentId], references: [id])
  beneficiaryUserId String
  beneficiary       User            @relation("PayoutBeneficiary", fields: [beneficiaryUserId], references: [id])
  amount            Int
  operator          PayoutOperator?
  phone             String?
  status            PayoutStatus    @default(PENDING)
  attempts          Int             @default(0)
  nextAttemptAt     DateTime        @default(now()) @db.Timestamptz(6)
  disburseToken     String?
  transactionId     String?
  // Frais réellement facturés par PayDunya pour cet envoi (remontés par
  // check-status) — sert à vérifier que TENANT_FEE_* couvre le coût réel.
  providerFee       Int?
  lastError         String?
  completedAt       DateTime?       @db.Timestamptz(6)
  createdAt         DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(6)

  @@index([status, nextAttemptAt])
  @@index([beneficiaryUserId])
  @@map("payouts")
}

// Couche éditable par le locataire tant que le Payment lié est en
// PENDING_CONFIRMATION (PATCH/DELETE côté API) — le Payment reste la
// ligne canonique consultée par le propriétaire/gestionnaire et les
// tableaux de bord.
model PaymentDeclaration {
  id               String        @id @default(cuid())
  paymentId        String        @unique
  payment          Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  declaredAmount   Int
  declaredAt       DateTime      @db.Timestamptz(6)
  declaredMethod   PaymentMethod
  proofStoragePath String?
  note             String?
  editedAt         DateTime?     @db.Timestamptz(6)
  // Anti-doublon des relances (voir build-plan.md unité 20, cron
  // PaymentDeclarationReminderTask) — posés après envoi, jamais réinitialisés
  // tant que la déclaration reste PENDING_CONFIRMATION.
  reminder3SentAt  DateTime?     @db.Timestamptz(6)
  reminder7SentAt  DateTime?     @db.Timestamptz(6)
  createdAt        DateTime      @default(now()) @db.Timestamptz(6)

  @@map("payment_declarations")
}

// ────────────────────────────────────────────────────────────────
// Annonces
// ────────────────────────────────────────────────────────────────

model Listing {
  id                String        @id @default(cuid())
  propertyId        String
  property          Property      @relation(fields: [propertyId], references: [id])
  publishedByUserId String
  publishedBy       User          @relation(fields: [publishedByUserId], references: [id])
  slug              String        @unique
  status            ListingStatus @default(ACTIVE)
  publishedAt       DateTime      @default(now()) @db.Timestamptz(6)
  deactivatedAt     DateTime?     @db.Timestamptz(6)
  suspendedAt       DateTime?     @db.Timestamptz(6)
  suspensionReason  String?
  createdAt         DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(6)

  @@index([propertyId])
  @@index([status])
  @@map("listings")
}

// ────────────────────────────────────────────────────────────────
// Gestionnaires et mandats
// ────────────────────────────────────────────────────────────────

// Contrainte non exprimable en Prisma : un seul Mandate ACTIVE par
// propertyId à la fois. À ajouter manuellement dans la migration
// générée : CREATE UNIQUE INDEX mandates_property_active_unique ON
// mandates (property_id) WHERE status = 'ACTIVE'.
model Mandate {
  id            String         @id @default(cuid())
  propertyId    String
  property      Property       @relation(fields: [propertyId], references: [id])
  ownerId       String
  owner         User           @relation("MandateOwner", fields: [ownerId], references: [id])
  managerId     String
  manager       User           @relation("MandateManager", fields: [managerId], references: [id])
  status        MandateStatus  @default(PENDING)
  feeType       MandateFeeType
  feeValue      Int
  startDate     DateTime       @db.Timestamptz(6)
  endDate       DateTime?      @db.Timestamptz(6)
  acceptedAt    DateTime?      @db.Timestamptz(6)
  revokedAt     DateTime?      @db.Timestamptz(6)
  revokedReason String?
  createdAt     DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(6)

  reviews ManagerReview[]

  @@index([propertyId, status])
  @@index([managerId])
  @@index([ownerId])
  @@map("mandates")
}

// Un avis par relation propriétaire↔gestionnaire, jamais par mandat
// individuel (voir /architect unité 34) — un propriétaire avec plusieurs
// biens confiés au même gestionnaire ne peut pas le noter plusieurs fois.
model ManagerReview {
  id        String   @id @default(cuid())
  managerId String
  manager   User     @relation("ManagerReviewManager", fields: [managerId], references: [id])
  ownerId   String
  owner     User     @relation("ManagerReviewOwner", fields: [ownerId], references: [id])
  mandateId String?
  mandate   Mandate? @relation(fields: [mandateId], references: [id])
  rating    Int
  comment   String?
  isHidden  Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([ownerId, managerId])
  @@index([managerId])
  @@map("manager_reviews")
}

// ────────────────────────────────────────────────────────────────
// Abonnements
// ────────────────────────────────────────────────────────────────

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id])
  tier                 SubscriptionTier   @default(STARTER)
  status               SubscriptionStatus @default(ACTIVE)
  betaUntil            DateTime?          @db.Timestamptz(6)
  promoDiscountPercent Int?
  currentPeriodEnd     DateTime?          @db.Timestamptz(6)
  cancelAt             DateTime?          @db.Timestamptz(6)
  createdAt            DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime           @updatedAt @db.Timestamptz(6)

  invoices SubscriptionInvoice[]

  @@map("subscriptions")
}

model SubscriptionInvoice {
  id              String        @id @default(cuid())
  subscriptionId  String
  subscription    Subscription  @relation(fields: [subscriptionId], references: [id])
  amount          Int
  status          InvoiceStatus @default(PENDING)
  transactionId   String?       @unique
  checkoutUrl     String?
  attemptCount    Int           @default(0)
  paidAt          DateTime?     @db.Timestamptz(6)
  periodStart     DateTime      @db.Timestamptz(6)
  periodEnd       DateTime      @db.Timestamptz(6)
  reminder3SentAt DateTime?     @db.Timestamptz(6)
  reminder7SentAt DateTime?     @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(6)

  @@index([subscriptionId])
  @@map("subscription_invoices")
}

// Réglages plateforme pilotés par le super-admin (voir /architect abonnements,
// 2026-09-30) — ligne unique (id fixe "singleton"), jamais un système de
// clé-valeur générique : seuls ces deux interrupteurs existent aujourd'hui,
// pas besoin d'une table ouverte à n'importe quelle clé pour deux booléens.
model PlatformSettings {
  id                          String             @id @default("singleton")
  subscriptionQuotasSuspended Boolean            @default(false)
  subscriptionBillingEnabled  Boolean            @default(false)
  // Calculée automatiquement (+6 mois) quand subscriptionQuotasSuspended
  // passe à true, effacée quand il repasse à false — voir /architect
  // bandeau promotionnel, 2026-10-02. Jamais un champ libre côté admin :
  // un seul bouton active les deux à la fois, pour que le bandeau ne
  // puisse jamais afficher une promesse que le quota réel ne tient pas.
  freePromotionEndsAt         DateTime?          @db.Timestamptz(6)
  // Forfaits dont les locataires ont accès à WhatsApp (unité 42) — réglable
  // par le super-admin sans changement de code ; les trois par défaut tant
  // que la direction n'a pas défini les formules (décision 2026-10-07). Le
  // forfait regardé est celui du responsable du bien
  // (resolveResponsibleUserId), jamais celui du locataire.
  whatsappEnabledTiers        SubscriptionTier[] @default([STARTER, PRO, PREMIUM])
  updatedAt                   DateTime           @updatedAt @db.Timestamptz(6)

  @@map("platform_settings")
}

// ────────────────────────────────────────────────────────────────
// Notifications, audit
// ────────────────────────────────────────────────────────────────

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([userId])
  @@map("push_subscriptions")
}

// Journal des envois déclenchés par NotifyService.notifyUser() — sert
// à l'écran admin « répartition push vs email » et au débogage des
// envois manqués, pas de logique métier ne dépend de cette table.
model Notification {
  id        String                     @id @default(cuid())
  userId    String
  user      User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     String
  channel   NotificationChannel
  status    NotificationDispatchStatus @default(SENT)
  payload   Json?
  error     String?
  createdAt DateTime                   @default(now()) @db.Timestamptz(6)
  // Ajouté le 2026-08-11 pour le popover de notifications — null = non lue.
  // Les lignes déjà en base au moment de la migration sont rétro-remplies à
  // leur createdAt (voir migration.sql) pour ne pas faire apparaître tout
  // l'historique comme "non lu" au premier déploiement.
  readAt    DateTime?                  @db.Timestamptz(6)

  @@index([userId])
  @@index([event])
  @@map("notifications")
}

// Une tentative d'envoi WhatsApp = une ligne (unité 42, /architect
// 2026-10-08). Aucune ligne n'est créée quand l'envoi est refusé par
// WhatsappAccessService (pas de consentement, forfait non inclus...).
// `payload` ne contient que les paramètres de rendu du modèle — jamais de
// secret, jeton ou code locataire ; ses données personnelles suivent la même
// conservation que la ligne. `recipientPhone` (8 chiffres) garde le numéro
// réellement utilisé, le numéro du locataire pouvant changer ensuite.
// Messages ENTRANTS (unité 44, /architect 2026-10-13) : recipientPhone est
// alors le numéro de l'EXPÉDITEUR (8 chiffres, ou format international
// complet hors Togo), userId est null pour un numéro inconnu, et sentAt est
// l'heure d'envoi par l'expéditeur, fournie par Meta.
model WhatsappMessage {
  id                  String                @id @default(cuid())
  userId              String?
  user                User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  recipientPhone      String
  direction           WhatsappDirection
  // Type du message tel qu'envoyé à Meta : une quittance part en TEMPLATE
  // (document en en-tête d'un modèle) — la pièce jointe se lit dans
  // payload.filename (convention /review unité 42).
  messageType         WhatsappMessageType
  templateName        String?
  // Événement déclencheur : 'payment-reminder', 'receipt', 'bot'...
  source              String
  status              WhatsappMessageStatus @default(QUEUED)
  // Distinct du statut : un FAILED de limite de débit est réessayable, un
  // FAILED de numéro invalide ne l'est pas ; un UNKNOWN ne l'est jamais.
  retryable           Boolean               @default(false)
  wamid               String?               @unique
  errorCode           String?
  errorMessage        String?
  payload             Json?
  scheduleEntryId     String?
  scheduleEntry       PaymentScheduleEntry? @relation(fields: [scheduleEntryId], references: [id], onDelete: SetNull)
  paymentId           String?
  payment             Payment?              @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  sentAt              DateTime?             @db.Timestamptz(6)
  failedAt            DateTime?             @db.Timestamptz(6)
  // Accusés Meta (unité 44) — heure fournie par Meta, jamais effacée une
  // fois remplie (voir applyStatusEvent). Pas de « lu » ≠ « pas lu » : le
  // locataire peut avoir désactivé les confirmations de lecture.
  deliveredAt         DateTime?             @db.Timestamptz(6)
  readAt              DateTime?             @db.Timestamptz(6)
  // Texte d'un message reçu (ou légende d'un média) — champ dédié pour
  // pouvoir l'effacer sans supprimer la ligne (suppression de compte,
  // future durée de conservation). Jamais journalisé. Null pour un numéro
  // inconnu : rien n'est gardé de quelqu'un sans lien avec WARAH.
  body                String?
  // Liste de travail durable des messages reçus (unité 44) : enregistrée
  // dans la même écriture que le message, reprise par la tâche de
  // rattrapage si le serveur redémarre avant la fin du traitement.
  // inboundAction : traitement attendu ('STOP_CONFIRMATION', puis le robot
  // à l'unité 47) ; null = rien à faire.
  inboundAction       String?
  processedAt         DateTime?             @db.Timestamptz(6)
  processingStartedAt DateTime?             @db.Timestamptz(6)
  processingAttempts  Int                   @default(0)
  // Nouveaux essais d'un envoi (unité 46) : numéro de la tentative (1 =
  // premier envoi, 3 au plus) et heure du premier envoi de la série (null
  // pour le premier lui-même) — la limite d'une heure se compte depuis elle.
  attempt             Int                   @default(1)
  firstAttemptAt      DateTime?             @db.Timestamptz(6)
  // Messagerie avec le responsable du bien (unité 48) : message relayé ou
  // réponse du responsable. sentByUserId = auteur d'une réponse (le nom
  // affiché est déjà dans payload.body, figé à l'envoi).
  threadId            String?
  thread              WhatsappThread?       @relation(fields: [threadId], references: [id], onDelete: SetNull)
  sentByUserId        String?
  createdAt           DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime              @updatedAt @db.Timestamptz(6)

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([threadId, createdAt])
  @@index([direction, processedAt, createdAt])
  @@map("whatsapp_messages")
}

// Historique du consentement WhatsApp — preuve exigée (politique WhatsApp,
// loi togolaise n° 2019-014) : les colonnes User.whatsappConsent* ne gardent
// que le dernier état. actorUserId = qui a concrètement agi (agent pour
// AGENCY, locataire pour BOT/TENANT_PORTAL), null uniquement pour SYSTEM.
model WhatsappConsentEvent {
  id               String                   @id @default(cuid())
  userId           String
  user             User                     @relation("WhatsappConsentSubject", fields: [userId], references: [id], onDelete: Cascade)
  previousConsent  WhatsappConsent
  newConsent       WhatsappConsent
  source           WhatsappConsentSource
  actorUserId      String?
  actor            User?                    @relation("WhatsappConsentActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  // Preuve (unité 45). noticeVersion : version du texte montré ou attesté
  // (ex. consentement-v1). collectionMethod : seulement pour AGENCY.
  // phoneLast2 : 2 derniers chiffres du numéro concerné, jamais le numéro
  // entier. requestId : la demande d'accord (PENDING) à laquelle répond un
  // « OUI ». sourceAt : heure Meta du message qui a déclenché le changement.
  kind             WhatsappConsentEventKind @default(CONSENT)
  noticeVersion    String?
  collectionMethod WhatsappConsentMethod?
  phoneLast2       String?
  requestId        String?
  sourceAt         DateTime?                @db.Timestamptz(6)
  // « OUI » en réponse à l'invitation du robot (unité 47) : heure de cette
  // invitation (preuve que l'accord répond à une invitation valable).
  invitedAt        DateTime?                @db.Timestamptz(6)
  createdAt        DateTime                 @default(now()) @db.Timestamptz(6)

  @@index([userId, createdAt])
  @@map("whatsapp_consent_events")
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id])
  action      String
  entityType  String?
  entityId    String?
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// Enregistré en base en plus de l'email envoyé au CONTACT_RECIPIENT_EMAIL
// (voir ContactService.submit()) — l'email seul se perdait déjà une fois
// (voir incident 2026-10-03, boîte mail non surveillée), le super-admin a
// besoin d'un endroit fiable sur la plateforme elle-même pour consulter et
// traiter ces messages (voir demande développeur, 2026-10-07).
model ContactMessage {
  id        String               @id @default(cuid())
  name      String
  role      String?
  email     String
  phone     String?
  city      String?
  subject   String
  message   String
  status    ContactMessageStatus @default(NEW)
  createdAt DateTime             @default(now()) @db.Timestamptz(6)

  @@index([status])
  @@index([createdAt])
  @@map("contact_messages")
}

// Conversation d'un locataire avec le robot WhatsApp (unité 47) — en base
// pour survivre à un redémarrage. Revient au menu après 30 min sans message.
// L'état n'autorise jamais rien à lui seul : une action protégée revérifie
// le code (TenantProfile.pinVerifiedAt / pinVerifiedPhone) à chaque fois.
// replyWindowStart / replyCount : anti-abus, 20 réponses par heure au plus,
// comptées par écriture conditionnelle.
model WhatsappConversation {
  id               String             @id @default(cuid())
  userId           String             @unique
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  state            WhatsappBotState   @default(MENU)
  pendingAction    WhatsappBotAction?
  lastActivityAt   DateTime           @default(now()) @db.Timestamptz(6)
  replyWindowStart DateTime           @default(now()) @db.Timestamptz(6)
  replyCount       Int                @default(0)
  // Fil de l'échange humain en cours (état HUMAN, unité 48).
  humanThreadId    String?
  humanThread      WhatsappThread?    @relation(fields: [humanThreadId], references: [id], onDelete: SetNull)
  createdAt        DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime           @updatedAt @db.Timestamptz(6)

  @@map("whatsapp_conversations")
}

// Fil d'un locataire avec le responsable d'UN bien (unité 48, /architect
// 2026-10-18) : un fil par couple locataire + bien, pour qu'un nouveau
// bailleur ne voie jamais les échanges avec l'ancien. Les droits ne sont
// jamais figés ici : canActOnProperty() sur le bien, à chaque accès.
// Échange « en cours » = humanOpenedAt rempli, humanClosedAt vide et dernier
// message du locataire de moins de 24 h (toujours calculé, aucune tâche).
model WhatsappThread {
  id                  String                     @id @default(cuid())
  tenantUserId        String
  tenant              User                       @relation("WhatsappThreadTenant", fields: [tenantUserId], references: [id], onDelete: Cascade)
  propertyId          String
  property            Property                   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  humanOpenedAt       DateTime?                  @db.Timestamptz(6)
  humanClosedAt       DateTime?                  @db.Timestamptz(6)
  closedReason        WhatsappThreadCloseReason?
  // Heure Meta du dernier message du locataire dans l'échange (ouverture
  // comprise) : départ du retour automatique au robot après 24 h.
  lastTenantMessageAt DateTime?                  @db.Timestamptz(6)
  // Dernier message du fil (relayé ou réponse) : tri de la liste.
  lastMessageAt       DateTime?                  @db.Timestamptz(6)
  // Premier message non lu (null = tout est lu). « Lu » = marqué par le
  // responsable du bien (POST .../read), jamais par une simple lecture.
  unreadSince         DateTime?                  @db.Timestamptz(6)
  agencyReadAt        DateTime?                  @db.Timestamptz(6)
  agencyReadById      String?
  // Réservation de la notification « une par vague » (écriture
  // conditionnelle), effacée à la lecture ; notifiedUserId permet de
  // réarmer pour un nouveau responsable.
  notifiedAt          DateTime?                  @db.Timestamptz(6)
  notifiedUserId      String?
  // Avis « photos et vocaux pas encore transmis » : un seul par échange.
  mediaNoticeSentAt   DateTime?                  @db.Timestamptz(6)
  createdAt           DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime                   @updatedAt @db.Timestamptz(6)

  messages      WhatsappMessage[]
  conversations WhatsappConversation[]

  @@unique([tenantUserId, propertyId])
  @@index([propertyId, lastMessageAt])
  @@map("whatsapp_threads")
}
